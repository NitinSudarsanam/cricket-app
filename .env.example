# Copy to .env and fill in real values.
# Required for a local or Vercel deploy are marked. Pusher and Sportmonks are optional.

# --- Database (required) ---
# Supabase: use the pooled URI (port 6543) for the app, direct (5432) for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth (required) ---
# At least 32 characters in production. SESSION_SECRET must differ from ADMIN_SECRET.
ADMIN_SECRET="change-me-admin-secret-at-least-32-chars"
SESSION_SECRET="change-me-session-secret-at-least-32"

# Public site URL used for server-side redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Real-time (optional) ---
# Leave unset to fall back to polling.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="mt1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# --- Live cricket data (optional) ---
SPORTMONKS_API_TOKEN=""
SPORTMONKS_DOMESTIC_COUNTRY_ID=""
SPORTMONKS_BASE_URL=""

# --- Scheduled sync (optional) ---
# Bearer secret for POST /api/sync/cricket-data. Falls back to ADMIN_SECRET.
CRON_SECRET=""
REQUIRE_SYNC_BEFORE_DRAFT=""

# --- Optional TLS ---
# DATABASE_CA_CERT=""
