// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id         String   @id @default(cuid())
  externalId String?  @unique // Sportmonks player id for upsert when syncing squads
  name       String
  team       String   // CSK, MI, GT, RR, RCB, KKR, LSG, SRH, PBKS, DC
  role       String   // Bat, Bowl, AR, WK
  isForeign  Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  picks            Pick[]
  playerScores     PlayerScore[]
  playerMatchStats PlayerMatchStat[]

  @@index([team])
  @@index([role])
}

// ============================================================================
// Score tracking and ranking (Sportmonks)
// ============================================================================

model League {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  slug       String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  seasons    Season[]
  teams      Team[]
}

model Season {
  id          String    @id @default(cuid())
  leagueId    String
  league      League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  externalId  String    @unique
  name        String
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  matches     Match[]
  teamScores  TeamScore[]
  @@index([leagueId])
}

model Team {
  id                  String    @id @default(cuid())
  externalId          String    @unique
  leagueId            String?
  league              League?   @relation(fields: [leagueId], references: [id])
  name                String
  shortCode           String?
  imageUrl            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  localMatches        Match[]   @relation("LocalTeam")
  visitorMatches      Match[]   @relation("VisitorTeam")
  winnerMatches       Match[]   @relation("WinnerTeam")
  matchResultsLocal   MatchResult[] @relation("MatchResultLocal")
  matchResultsVisitor MatchResult[] @relation("MatchResultVisitor")
  matchResultsWinner  MatchResult[] @relation("MatchResultWinner")
  teamScores          TeamScore[]
  @@index([leagueId])
}

model Match {
  id             String    @id @default(cuid())
  externalId     String    @unique
  seasonId       String
  season         Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  leagueId       String?
  localTeamId    String
  localTeam      Team      @relation("LocalTeam", fields: [localTeamId], references: [id])
  visitorTeamId  String
  visitorTeam    Team      @relation("VisitorTeam", fields: [visitorTeamId], references: [id])
  startAt        DateTime
  status         String
  winnerTeamId   String?
  winnerTeam     Team?     @relation("WinnerTeam", fields: [winnerTeamId], references: [id])
  resultSummary  String?
  rawPayload     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  matchResult      MatchResult?
  playerMatchStats PlayerMatchStat[]
  @@index([seasonId])
  @@index([status])
  @@index([seasonId, status])
}

model MatchResult {
  id            String    @id @default(cuid())
  matchId       String    @unique
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  localTeamId   String
  localTeam     Team      @relation("MatchResultLocal", fields: [localTeamId], references: [id])
  visitorTeamId String
  visitorTeam   Team      @relation("MatchResultVisitor", fields: [visitorTeamId], references: [id])
  winnerTeamId  String?
  winnerTeam    Team?     @relation("MatchResultWinner", fields: [winnerTeamId], references: [id])
  localScore    String?
  visitorScore  String?
  outcome       String
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
}

model ScoringRule {
  id            String    @id @default(cuid())
  leagueId      String?
  seasonId      String?
  outcome       String
  points        Int
  name          String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TeamScore {
  id            String    @id @default(cuid())
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seasonId      String
  season        Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  points        Int       @default(0)
  matchesPlayed Int       @default(0)
  wins          Int       @default(0)
  ties          Int       @default(0)
  noResults     Int       @default(0)
  losses        Int       @default(0)
  lastMatchAt   DateTime?
  updatedAt     DateTime  @updatedAt
  @@unique([teamId, seasonId])
  @@index([seasonId])
  @@index([seasonId, points])
}

model PlayerScore {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seasonId  String?
  points    Int      @default(0)
  source    String
  breakdown Json?
  updatedAt DateTime @updatedAt
  @@index([seasonId])
  @@index([playerId, seasonId])
  @@index([seasonId, source])
}

model PlayerMatchStat {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  seasonId     String
  runs         Int      @default(0)
  ballsFaced   Int      @default(0)
  fours        Int      @default(0)
  sixes        Int      @default(0)
  wickets      Int      @default(0)
  oversBowled  Float    @default(0)
  maidens      Int      @default(0)
  bowlingRuns  Int      @default(0)
  catches      Int      @default(0)
  stumpings    Int      @default(0)
  runOuts      Int      @default(0)
  didBat       Boolean  @default(false)
  didBowl      Boolean  @default(false)
  dismissed    Boolean  @default(false)
  rawPayload   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([playerId, matchId])
  @@index([matchId])
  @@index([seasonId])
  @@index([playerId, seasonId])
}

model FantasyScoringRule {
  id            String    @id @default(cuid())
  statKey       String
  points        Int
  name          String?
  leagueId      String?
  seasonId      String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([seasonId])
  @@index([statKey])
}

model LeaderboardSnapshot {
  id         String   @id @default(cuid())
  type       String
  leagueId   String?
  seasonId   String
  snapshotAt DateTime
  payload    Json
  createdAt  DateTime @default(now())
  @@index([type, seasonId])
}

model DraftConfig {
  id            String   @id @default(cuid())
  rosterSize    Int      @default(8)
  totalRounds   Int      @default(8)
  minPerTeam    Int      @default(0)
  maxPerTeam    Int      @default(1)
  
  // Mandatory role requirements
  mandatoryBat  Int      @default(3)
  mandatoryBowl Int      @default(3)
  mandatoryAR   Int      @default(0)
  mandatoryWK   Int      @default(0)
  
  // Early round rules
  earlyRounds   Int      @default(4)
  earlyMinBat   Int      @default(2)
  earlyMinBowl  Int      @default(2)
  
  isLocked            Boolean  @default(false)
  pickTimeoutSeconds  Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  draftStates   DraftState[]
}

model Participant {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  picks     Pick[]
  draftOrders DraftOrder[]
}

model DraftState {
  id                String   @id @default(cuid())
  currentRound      Int      @default(1)
  currentPickIndex  Int      @default(0)
  draftOrderType    String   @default("snake") // snake | linear
  status            String   @default("not_started") // not_started, in_progress, paused, completed
  startedAt         DateTime?
  completedAt       DateTime?
  turnStartedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Foreign keys
  draftConfigId     String
  draftConfig       DraftConfig @relation(fields: [draftConfigId], references: [id], onDelete: Cascade)

  // Relations
  picks             Pick[]
  draftOrders       DraftOrder[]

  @@index([status])
}

model DraftOrder {
  id              String   @id @default(cuid())
  position        Int      // 0-indexed position in draft order
  createdAt       DateTime @default(now())

  // Foreign keys
  draftStateId    String
  participantId   String
  
  draftState      DraftState  @relation(fields: [draftStateId], references: [id], onDelete: Cascade)
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([draftStateId, position])
  @@unique([draftStateId, participantId])
  @@index([draftStateId])
}

model Pick {
  id            String   @id @default(cuid())
  round         Int
  pickNumber    Int      // Overall pick number in the draft
  timestamp     DateTime @default(now())

  // Foreign keys
  draftStateId  String
  participantId String
  playerId      String

  draftState    DraftState  @relation(fields: [draftStateId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([draftStateId, playerId]) // Each player can only be picked once per draft
  @@index([draftStateId])
  @@index([participantId])
  @@index([round])
}
